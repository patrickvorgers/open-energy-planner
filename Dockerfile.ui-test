FROM mcr.microsoft.com/playwright/python:v1.64.1-noble@sha256:330d401ae23c905896a0c26c66c36fc971b621519e7b11b435a8328d7bf6e031
RUN python -m pip install --no-cache-dir pytest==9.1.1 playwright==1.64.1
WORKDIR /workspace
COPY requirements.lock ./
RUN python -m pip install --no-cache-dir --only-binary=:all: --require-hashes -r requirements.lock
COPY docs/site/requirements.txt /tmp/oep-docs-requirements.txt
RUN python -m pip install --no-cache-dir --target /opt/oep-docs -r /tmp/oep-docs-requirements.txt
COPY . .
RUN PYTHONPATH=/opt/oep-docs python -m unittest discover -s docs/site -p test_site.py -v \
    && PYTHONPATH=/opt/oep-docs python -m mkdocs build --strict --config-file docs/site/mkdocs.yml --site-dir /workspace/_site
RUN mkdir -p results/ci
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONPATH=/workspace/src OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1
ENTRYPOINT ["python"]
CMD ["-m", "script.ci.pytest_suites", "browser"]

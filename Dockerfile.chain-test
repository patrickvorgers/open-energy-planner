FROM ghcr.io/home-assistant/home-assistant:2026.11.1@sha256:6785d1eca68747a524c156faae1b139ed415c07357386ae6fe17291986e59e82
RUN uv pip install --system pytest==9.1.1 ruff==0.17.1 iniconfig==2.3.0 pluggy==1.6.0
WORKDIR /workspace
COPY pyproject.toml ./
COPY requirements.lock LICENSE NOTICE THIRD_PARTY_NOTICES.md ./
COPY ha_app ./ha_app
COPY src ./src
COPY custom_components ./custom_components
COPY tests ./tests
COPY script ./script
COPY test_environment ./test_environment
RUN mkdir results
ENV PYTHONDONTWRITEBYTECODE=1 OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1 MKL_NUM_THREADS=1
ENTRYPOINT ["python"]
CMD ["-m", "script.ci.check_ha"]

{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Development: Set up environment",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": ["script/ci/setup.py"],
      "problemMatcher": []
    },
    {
      "label": "Development: Check native code and scenarios",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": ["script/ci/check_native.py"],
      "group": {"kind": "test", "isDefault": true},
      "problemMatcher": []
    },
    {
      "label": "Development: Test developer page in browsers",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": ["-m", "pytest", "-q", "tests/frontend"],
      "group": "test",
      "problemMatcher": []
    }
  ]
}

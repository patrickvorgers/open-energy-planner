FROM python:3.15.0-slim-bookworm@sha256:0e019bbdfb5d9874cb2389f1c2884b64aa2ac97c99960b5bc521cef978c0617d
WORKDIR /workspace
COPY requirements.lock ./
RUN python -m pip install --no-cache-dir --only-binary=:all: --require-hashes -r requirements.lock
RUN python -m pip install --no-cache-dir pytest==9.1.1 ruff==0.17.1 iniconfig==2.3.0 pluggy==1.6.0 packaging==26.3 pygments==2.21.0
COPY . .
RUN mkdir -p results
ENV PYTHONPATH=/workspace/src PYTHONDONTWRITEBYTECODE=1 OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1 MKL_NUM_THREADS=1
ENTRYPOINT ["python"]
CMD ["-m", "script.ci.pytest_suites", "native"]

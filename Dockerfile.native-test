FROM python:3.15.1-slim-bookworm@sha256:575f8bc12ec26542e0678bc6b60e385218248019d433157ec327264a78c3a853
WORKDIR /workspace
COPY requirements.lock ./
RUN python -m pip install --no-cache-dir --only-binary=:all: --require-hashes -r requirements.lock
RUN python -m pip install --no-cache-dir pytest==9.1.1 ruff==0.17.1 iniconfig==2.3.0 pluggy==1.6.0 packaging==26.3 pygments==2.21.0 lizard==1.26.1 pathspec==1.1.1
COPY . .
RUN mkdir -p results
ENV PYTHONPATH=/workspace/src PYTHONDONTWRITEBYTECODE=1 OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1 MKL_NUM_THREADS=1
ENTRYPOINT ["python"]
CMD ["-m", "script.ci.pytest_suites", "native"]
